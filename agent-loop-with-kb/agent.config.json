{
  "_comment": "Each node can have its own model. reviewer/tester fall back to developer config if not set.",

  "repo": "",
  "branch": "main",
  "project_path": "../knitwit",

  "manager": {
    "provider": "anthropic",
    "model": "claude-opus-4-5",
    "api_key_env": "ANTHROPIC_API_KEY",
    "max_tokens": 4096
  },

  "developer": {
    "provider": "anthropic",
    "model": "claude-sonnet-4-6",
    "api_key_env": "ANTHROPIC_API_KEY",
    "max_tokens": 8192
  },

  "reviewer": {
    "provider": "anthropic",
    "model": "claude-sonnet-4-6",
    "api_key_env": "ANTHROPIC_API_KEY",
    "max_tokens": 4096
  },

  "tester": {
    "provider": "anthropic",
    "model": "claude-sonnet-4-6",
    "api_key_env": "ANTHROPIC_API_KEY",
    "max_tokens": 4096
  }
}
