{
  "_comment": "Each node can have its own model. reviewer/tester fall back to developer config if not set.",

  "repo": "https://github.com/krafteq/krafteq.dev",
  "branch": "agent-loop-with-kb",
  "project_path": "../agent-loop-with-kb-simple-project",
  "jira": {
    "base_url": "https://shraddhajasinska.atlassian.net",
    "email_env": "JIRA_EMAIL",
    "token_env": "JIRA_API_TOKEN",
    "project_key": "KAN",
    "pull_status": "To Do",
    "in_progress_status": "In Progress",
    "done_status": "Resolved"
  },
  "manager": {
    "provider": "openai",
    "model": "gpt-4o",
    "api_key_env": "OPENAI_API_KEY",
    "max_tokens": 4096
  },
  "developer": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY",
    "max_tokens": 8192
  },
  "reviewer": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY",
    "max_tokens": 4096
  },
  "tester": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY",
    "max_tokens": 4096
  }
}
